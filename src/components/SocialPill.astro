---
import { site } from '../data/site';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;

const iconClass = 'h-5 w-5';
---

<div class:list={['flex items-center gap-0.5 rounded-full border border-line bg-surface px-1.5 py-1', className]}>
  <a
    href={site.github}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="GitHub (opens in a new tab)"
    class="grid h-8 w-8 place-items-center rounded-full text-ink-2 transition-colors hover:bg-surface-2 hover:text-ink"
  >
    <svg class={iconClass} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 .5C5.73.5.75 5.48.75 11.75c0 4.97 3.22 9.18 7.69 10.67.56.1.77-.24.77-.54v-1.9c-3.13.68-3.79-1.51-3.79-1.51-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.72 1.16 1.72 1.16 1 1.72 2.63 1.22 3.27.93.1-.73.39-1.22.71-1.5-2.5-.28-5.13-1.25-5.13-5.57 0-1.23.44-2.24 1.16-3.03-.12-.28-.5-1.43.11-2.98 0 0 .95-.3 3.1 1.16a10.7 10.7 0 0 1 5.64 0c2.15-1.46 3.1-1.16 3.1-1.16.61 1.55.23 2.7.11 2.98.72.79 1.16 1.8 1.16 3.03 0 4.33-2.64 5.28-5.15 5.56.4.35.76 1.03.76 2.08v3.08c0 .3.2.65.78.54A11.26 11.26 0 0 0 23.25 11.75C23.25 5.48 18.27.5 12 .5Z" />
    </svg>
  </a>
  <a
    href={site.linkedin}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="LinkedIn (opens in a new tab)"
    class="grid h-8 w-8 place-items-center rounded-full text-ink-2 transition-colors hover:bg-surface-2 hover:text-ink"
  >
    <svg class={iconClass} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M4.75 7.75a3 3 0 0 1 3-3h8.5a3 3 0 0 1 3 3v8.5a3 3 0 0 1-3 3h-8.5a3 3 0 0 1-3-3v-8.5Z" />
      <path d="M10.75 16.25V14a2.25 2.25 0 0 1 4.5 0v2.25M10.75 11.75v4.5M8.25 11.75v4.5M8.25 8.75v.01" />
    </svg>
  </a>
  <a
    href={`mailto:${site.email}`}
    aria-label={`Email ${site.email}`}
    class="grid h-8 w-8 place-items-center rounded-full text-ink-2 transition-colors hover:bg-surface-2 hover:text-ink"
  >
    <svg class={iconClass} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M4.75 7.75a2 2 0 0 1 2-2h10.5a2 2 0 0 1 2 2v8.5a2 2 0 0 1-2 2H6.75a2 2 0 0 1-2-2v-8.5Z" />
      <path d="m5.5 6.5 6.5 5.75 6.5-5.75" />
    </svg>
  </a>
</div>
