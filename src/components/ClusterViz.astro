---
import SectionHeader from './SectionHeader.astro';
import { clusterTags } from '../data/site';
---

<!-- ── CLUSTER VIZ ── -->
<section id="cluster-section" class="pt-24 md:pt-32" aria-labelledby="cluster-title">
  <SectionHeader
    id="cluster-title"
    eyebrow="Infrastructure"
    title="Kubernetes cluster"
    subtitle="Every request passes through Authentik, ztunnel mTLS, and Kyverno policy before it reaches a pod"
  />

  <div class="reveal rounded-3xl border border-line bg-canvas p-2">
    <div class="relative overflow-hidden rounded-2xl bg-panel ring-1 ring-white/5">
      <!-- Dotted grid + glow -->
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(rgb(148_163_184/0.14)_1px,transparent_1.5px)] [background-size:18px_18px]" aria-hidden="true"></div>
      <div class="pointer-events-none absolute left-1/2 top-1/2 h-[420px] w-[420px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-indigo-600 opacity-15 blur-[120px]" aria-hidden="true"></div>

      <!-- Window chrome -->
      <div class="relative flex items-center justify-between border-b border-white/10 px-4 py-3">
        <div class="flex items-center gap-3">
          <div class="flex gap-1.5" aria-hidden="true">
            <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
          </div>
          <p class="font-mono text-xs text-slate-400">request-path</p>
        </div>
        <button
          id="cluster-toggle"
          type="button"
          class="flex h-7 items-center gap-1.5 rounded-full border border-white/10 bg-white/5 px-2.5 font-mono text-xs text-slate-300 transition-colors hover:border-cyan-400/40 hover:text-cyan-300 focus-visible:outline-cyan-300"
          aria-pressed="false"
          aria-label="Pause animation"
        >
          <svg data-icon="pause" class="h-3 w-3" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><rect x="2" y="1.5" width="2.8" height="9" rx="0.8" /><rect x="7.2" y="1.5" width="2.8" height="9" rx="0.8" /></svg>
          <svg data-icon="play" class="hidden h-3 w-3" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="M3 1.8v8.4a.6.6 0 0 0 .9.5l6.6-4.2a.6.6 0 0 0 0-1L3.9 1.3a.6.6 0 0 0-.9.5Z" /></svg>
          <span aria-hidden="true">live</span>
        </button>
      </div>

      <div class="relative px-3 py-10 sm:px-8 md:py-14">
        <p class="sr-only">
          Diagram: a request travels from a client through Authentik (auth), ztunnel (mTLS, L4) and Kyverno (policy) to a pod,
          which answers 200 OK; the response travels back through ztunnel to the client.
        </p>
        <div class="flex justify-center">
          <svg id="cluster-svg" viewBox="0 0 900 260" class="w-full max-w-3xl" aria-hidden="true">
            <defs>
              <filter id="pkt-glow" x="-100%" y="-100%" width="300%" height="300%">
                <feGaussianBlur stdDeviation="3" result="blur"/>
                <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
              </filter>
              <filter id="node-glow-f" x="-50%" y="-50%" width="200%" height="200%">
                <feGaussianBlur stdDeviation="9" result="blur"/>
                <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
              </filter>
            </defs>

            <!-- Wire -->
            <line x1="90" y1="130" x2="794" y2="130" stroke="#6366f1" stroke-width="1.2" opacity="0.2"/>

            <!-- Traveling request/response token -->
            <polygon id="k8s-token" points="-6,-4 6,0 -6,4" fill="#818cf8" filter="url(#pkt-glow)" opacity="0.95"/>

            <!-- ── client ── -->
            <g transform="translate(70,130)">
              <circle class="client-ring" r="27" fill="none" stroke="#67e8f9" stroke-width="1.5" opacity="0"/>
              <circle r="20" fill="rgba(15,14,23,0.97)" stroke="#64748b" stroke-width="1.5"/>
              <circle cx="0" cy="-3" r="3.4" fill="none" stroke="#94a3b8" stroke-width="1.3"/>
              <path d="M-7,7 a7,6.5 0 0 1 14,0 Z" fill="none" stroke="#94a3b8" stroke-width="1.3"/>
              <text y="34" text-anchor="middle" fill="#94a3b8" font-size="12" font-family="Inter,sans-serif">client</text>
            </g>

            <!-- ── Authentik (auth gate) ── -->
            <g class="k8s-gate" data-gate="authentik" transform="translate(255,130)">
              <circle class="gate-ring" r="34" fill="none" stroke="#475569" stroke-width="1.5" opacity="0.35"/>
              <circle r="26" fill="rgba(15,14,23,0.97)" stroke="#818cf8" stroke-width="1.5" filter="url(#node-glow-f)"/>
              <!-- shield icon -->
              <path d="M0,-12 L10,-7 V2 C10,9 5,13 0,15 C-5,13 -10,9 -10,2 V-7 Z" fill="rgba(129,140,248,0.14)" stroke="#818cf8" stroke-width="1.4"/>
              <circle cx="0" cy="-1" r="2.4" fill="none" stroke="#818cf8" stroke-width="1.2"/>
              <line x1="0" y1="1.4" x2="0" y2="5" stroke="#818cf8" stroke-width="1.2"/>
              <text y="46" text-anchor="middle" fill="#94a3b8" font-size="12" font-family="Inter,sans-serif">Authentik</text>
              <text y="59" text-anchor="middle" fill="#64748b" font-size="9" font-family="Inter,sans-serif">auth</text>
              <g class="gate-check" opacity="0" transform="translate(20,-20)">
                <circle r="8" fill="#10b981"/>
                <path d="M-3.5,0 L-1,3 L4,-3.5" fill="none" stroke="white" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </g>
            </g>

            <!-- ── ztunnel (mTLS gate) ── -->
            <g class="k8s-gate" data-gate="ztunnel" transform="translate(440,130)">
              <circle class="gate-ring" r="34" fill="none" stroke="#475569" stroke-width="1.5" opacity="0.35"/>
              <circle r="26" fill="rgba(15,14,23,0.97)" stroke="#67e8f9" stroke-width="1.5" filter="url(#node-glow-f)"/>
              <!-- padlock icon -->
              <rect x="-8" y="-2" width="16" height="13" rx="2.5" fill="rgba(103,232,249,0.14)" stroke="#67e8f9" stroke-width="1.4"/>
              <path d="M-5,-2 V-6 a5,5 0 0 1 10,0 V-2" fill="none" stroke="#67e8f9" stroke-width="1.4"/>
              <circle cx="0" cy="4" r="1.6" fill="#67e8f9"/>
              <text y="46" text-anchor="middle" fill="#94a3b8" font-size="12" font-family="Inter,sans-serif">ztunnel</text>
              <text y="59" text-anchor="middle" fill="#64748b" font-size="9" font-family="Inter,sans-serif">mTLS · L4</text>
              <g class="gate-check" opacity="0" transform="translate(20,-20)">
                <circle r="8" fill="#10b981"/>
                <path d="M-3.5,0 L-1,3 L4,-3.5" fill="none" stroke="white" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </g>
            </g>

            <!-- ── Kyverno (policy gate) ── -->
            <g class="k8s-gate" data-gate="kyverno" transform="translate(625,130)">
              <circle class="gate-ring" r="34" fill="none" stroke="#475569" stroke-width="1.5" opacity="0.35"/>
              <circle r="26" fill="rgba(15,14,23,0.97)" stroke="#34d399" stroke-width="1.5" filter="url(#node-glow-f)"/>
              <!-- policy / clipboard icon -->
              <rect x="-8" y="-11" width="16" height="21" rx="2.5" fill="rgba(52,211,153,0.14)" stroke="#34d399" stroke-width="1.4"/>
              <rect x="-4" y="-13" width="8" height="3.5" rx="1" fill="#34d399"/>
              <path d="M-4.5,0 L-1.5,3 L4.5,-4" fill="none" stroke="#34d399" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
              <text y="46" text-anchor="middle" fill="#94a3b8" font-size="12" font-family="Inter,sans-serif">Kyverno</text>
              <text y="59" text-anchor="middle" fill="#64748b" font-size="9" font-family="Inter,sans-serif">policy</text>
              <g class="gate-check" opacity="0" transform="translate(20,-20)">
                <circle r="8" fill="#10b981"/>
                <path d="M-3.5,0 L-1,3 L4,-3.5" fill="none" stroke="white" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </g>
            </g>

            <!-- ── pod ── -->
            <g transform="translate(820,130)">
              <text class="pod-status" y="-40" text-anchor="middle" fill="#34d399" font-size="11" font-weight="600" opacity="0" font-family="Inter,sans-serif">200 OK</text>
              <circle r="32" fill="rgba(129,140,248,0.06)" stroke="rgba(129,140,248,0.16)" stroke-width="1"/>
              <circle r="24" fill="rgba(15,14,23,0.97)" stroke="rgba(129,140,248,0.7)" stroke-width="1.5"/>
              <!-- container/hexagon icon -->
              <path d="M0,-11 L9.5,-5.5 V5.5 L0,11 L-9.5,5.5 V-5.5 Z" fill="rgba(129,140,248,0.16)" stroke="#818cf8" stroke-width="1.3"/>
              <text y="44" text-anchor="middle" fill="#94a3b8" font-size="12" font-family="Inter,sans-serif">pod</text>
            </g>
          </svg>
        </div>

        <!-- Tech tags -->
        <ul class="mt-10 flex flex-wrap justify-center gap-2" aria-label="Cluster stack">
          {clusterTags.map((t) => (
            <li class="cursor-default rounded-full border border-white/10 bg-white/5 px-3 py-1.5 font-mono text-xs text-slate-400 transition-colors duration-200 hover:border-cyan-400/40 hover:text-cyan-300">
              {t}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  // ── Kubernetes animation: request journey through Authentik → ztunnel → Kyverno → pod ──
  (function () {
    const svg = document.getElementById('cluster-svg');
    if (!svg) return;

    const X_CLIENT = 70, X_AUTH = 255, X_ZTUNNEL = 440, X_KYVERNO = 625, X_POD = 820;
    const Y = 130;
    const SPAN = X_POD - X_CLIENT;

    // Cycle phases, as fractions of the total loop duration T
    const T = 7000;
    const P_FWD_END    = 0.42; // client → pod (through all 3 gates)
    const P_POD_END    = 0.47; // brief "200 OK" dwell at the pod
    const P_BACK_END   = 0.89; // pod → client (ztunnel only — auth/policy don't re-check responses)
    // P_BACK_END → 1.0     : brief dwell at the client before the next request

    const frac = (x: number) => (x - X_CLIENT) / SPAN;
    const T_AUTH    = frac(X_AUTH)    * P_FWD_END;
    const T_ZTUNNEL = frac(X_ZTUNNEL) * P_FWD_END;
    const T_KYVERNO = frac(X_KYVERNO) * P_FWD_END;
    const T_ZTUNNEL_BACK = P_POD_END + (1 - frac(X_ZTUNNEL)) * (P_BACK_END - P_POD_END);

    const token = document.getElementById('k8s-token');
    const podStatus = svg.querySelector('.pod-status');
    const clientRing = svg.querySelector('.client-ring');
    const gates = Array.from(svg.querySelectorAll('.k8s-gate')).map(g => ({
      name: g.getAttribute('data-gate'),
      ring: g.querySelector('.gate-ring') as SVGCircleElement,
      check: g.querySelector('.gate-check') as SVGGElement,
    }));

    function setGate(gate: typeof gates[number], active: boolean, pulse = false) {
      if (gate.ring) {
        gate.ring.setAttribute('stroke', active ? '#10b981' : '#475569');
        gate.ring.setAttribute('opacity', pulse ? '1' : active ? '0.85' : '0.35');
        gate.ring.setAttribute('stroke-width', pulse ? '2.5' : '1.5');
      }
      if (gate.check) gate.check.setAttribute('opacity', active ? '1' : '0');
    }

    // Elapsed-time clock so the loop can pause (button, off-screen) and resume
    // exactly where it left off.
    let elapsed = 0, last = 0, running = false, onScreen = false;
    let userPaused = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function render(t: number) {
      let x = X_CLIENT, visible = true, forward = true;
      if (t < P_FWD_END) {
        x = X_CLIENT + SPAN * (t / P_FWD_END);
        forward = true;
      } else if (t < P_POD_END) {
        visible = false; // arriving — pod flashes its own status instead
      } else if (t < P_BACK_END) {
        const u = (t - P_POD_END) / (P_BACK_END - P_POD_END);
        x = X_POD - SPAN * u;
        forward = false;
      } else {
        visible = false; // delivered — brief pause before the next request
      }

      if (token) {
        token.setAttribute('transform', `translate(${x.toFixed(1)} ${Y}) rotate(${forward ? 0 : 180})`);
        token.setAttribute('fill', forward ? '#818cf8' : '#67e8f9');
        token.setAttribute('opacity', visible ? '0.95' : '0');
      }

      gates.forEach(gate => {
        if (gate.name === 'authentik') setGate(gate, t >= T_AUTH);
        else if (gate.name === 'kyverno') setGate(gate, t >= T_KYVERNO);
        else if (gate.name === 'ztunnel') {
          const active = t >= T_ZTUNNEL;
          const pulse = Math.abs(t - T_ZTUNNEL_BACK) < 0.02;
          setGate(gate, active, pulse);
        }
      });

      if (podStatus) podStatus.setAttribute('opacity', (t >= P_FWD_END && t < 0.55) ? '1' : '0');
      if (clientRing) clientRing.setAttribute('opacity', t >= P_BACK_END ? '0.8' : '0');
    }

    function frame(now: number) {
      if (!running) return;
      elapsed += last ? now - last : 0;
      last = now;
      render((elapsed % T) / T);
      requestAnimationFrame(frame);
    }

    function sync() {
      const shouldRun = onScreen && !userPaused;
      if (shouldRun && !running) { running = true; last = 0; requestAnimationFrame(frame); }
      else if (!shouldRun) running = false;
      if (toggle) {
        toggle.setAttribute('aria-pressed', String(userPaused));
        toggle.querySelector('[data-icon="pause"]')?.classList.toggle('hidden', userPaused);
        toggle.querySelector('[data-icon="play"]')?.classList.toggle('hidden', !userPaused);
      }
    }

    const toggle = document.getElementById('cluster-toggle');
    toggle?.addEventListener('click', () => { userPaused = !userPaused; sync(); });

    // Static frame with every gate passed, shown until/unless the loop runs
    render(0.44);

    const section = document.getElementById('cluster-section');
    if (section) {
      // Only animate while visible (saves CPU/battery when scrolled away)
      new IntersectionObserver((entries) => {
        onScreen = entries[0].isIntersecting;
        sync();
      }, { threshold: 0.2 }).observe(section);
    }
    sync();
  })();
</script>
