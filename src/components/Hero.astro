---
import Logo from './Logo.astro';
import { roles, site } from '../data/site';

// Tilted "polaroid" cards fanned under the headline (the reference uses a photo
// gallery here). Every label is drawn from facts already on the page.
const cards = [
  { k: 'HPC', v: 'Slurm · Open OnDemand', icon: 'M4 5h16v5H4zM4 14h16v5H4zM7.5 7.5h.01M7.5 16.5h.01', rot: 'sm:-rotate-[7deg]', y: 'lg:translate-y-4', tint: 'from-amber-200/70 to-orange-100/40 dark:from-amber-400/20 dark:to-orange-400/5' },
  { k: 'MLOps', v: 'Kubernetes · Kafka', icon: 'M9 4v2M15 4v2M9 18v2M15 18v2M4 9h2M4 15h2M18 9h2M18 15h2M7 6h10a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1ZM10 10h4v4h-4z', rot: 'sm:rotate-[4deg]', y: 'lg:-translate-y-2', tint: 'from-indigo-200/70 to-violet-100/40 dark:from-indigo-400/25 dark:to-violet-400/5' },
  { k: 'Homelab', v: '25+ self-hosted services', icon: 'M3.5 11 12 4l8.5 7M6 9.5V20h12V9.5M10 20v-5h4v5', rot: 'sm:-rotate-[3deg]', y: 'lg:translate-y-3', tint: 'from-cyan-200/70 to-sky-100/40 dark:from-cyan-400/20 dark:to-sky-400/5' },
  { k: 'Based in', v: site.location, icon: 'M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11ZM12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z', rot: 'sm:rotate-[6deg]', y: 'lg:-translate-y-1', tint: 'from-emerald-200/70 to-teal-100/40 dark:from-emerald-400/20 dark:to-teal-400/5' },
];
---

<section id="top" class="pt-12 md:pt-20" aria-labelledby="hero-title">
  <!-- Monogram in a tilted frame -->
  <div class="fade-up mx-auto mb-8 w-fit" style="animation-delay: 0ms">
    <div class="group relative rounded-[22px] border border-line p-1.5 transition-colors duration-500 hover:border-accent/50">
      <div class="shadow-box grid h-[88px] w-[88px] place-items-center rounded-2xl">
        <Logo size={64} class="rotate-[-6deg] rounded-xl shadow-lg transition-transform duration-500 group-hover:rotate-0 group-hover:scale-105" />
      </div>
    </div>
  </div>

  <div class="fade-up mx-auto mb-6 flex w-fit items-center gap-2 rounded-full border border-line bg-canvas px-3 py-1 text-sm text-ink-2" style="animation-delay: 150ms">
    <span class="relative flex h-2 w-2" aria-hidden="true">
      <span class="ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
      <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
    </span>
    <!-- Screen readers get the full list once instead of a constantly changing string -->
    <span class="sr-only">{roles.join(', ')}</span>
    <span aria-hidden="true" class="font-mono text-[13px] text-ink"><span id="typewriter-text">{roles[0]}</span><span class="tw-cursor"></span></span>
  </div>

  <h1
    id="hero-title"
    class="fade-up mx-auto max-w-2xl text-balance text-center text-5xl font-medium leading-[1.05] tracking-tighter text-ink sm:text-6xl md:text-7xl"
    style="animation-delay: 300ms"
  >
    Iasonas <span class="bg-gradient-to-r from-indigo-500 via-violet-500 to-cyan-500 bg-clip-text text-transparent dark:from-indigo-300 dark:via-violet-300 dark:to-cyan-300">Kakandris</span>
  </h1>

  <p class="fade-up mx-auto mt-6 max-w-xl text-balance text-center text-lg leading-8 text-ink-2" style="animation-delay: 400ms">
    Building infrastructure where AI research meets compute — HPC clusters, MLOps pipelines, and self-hosted systems.
  </p>

  <div class="fade-up mt-8 flex flex-wrap justify-center gap-3" style="animation-delay: 500ms">
    <a
      href="#journey"
      class="inline-flex items-center gap-2 rounded-full bg-ink px-5 py-2.5 text-sm font-medium text-canvas transition-transform duration-200 hover:-translate-y-0.5"
    >
      My Journey
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12l7 7 7-7" /></svg>
    </a>
    <a
      href={`mailto:${site.email}`}
      class="inline-flex items-center rounded-full border border-line bg-canvas px-5 py-2.5 text-sm font-medium text-ink transition-all duration-200 hover:-translate-y-0.5 hover:bg-surface"
    >
      Get in touch
    </a>
  </div>

  <!-- Fanned cards -->
  <ul class="mx-auto mt-14 grid max-w-4xl grid-cols-2 gap-3 sm:gap-4 md:mt-20 lg:grid-cols-4 lg:gap-0" aria-label="At a glance">
    {cards.map((c, i) => (
      <li class="fade-up" style={`animation-delay: ${600 + i * 90}ms`}>
        <div
          class:list={[
            'drama-shadow group mx-auto rounded-2xl bg-surface p-2 transition-transform duration-500 ease-out hover:z-10 hover:rotate-0 hover:scale-[1.04] lg:w-[210px]',
            c.rot,
            c.y,
          ]}
        >
          <div class:list={['grid h-24 place-items-center rounded-xl bg-gradient-to-br sm:h-28', c.tint]}>
            <svg class="h-10 w-10 text-ink/70 transition-transform duration-500 group-hover:scale-110" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={c.icon} /></svg>
          </div>
          <div class="px-2 pb-1 pt-3">
            <p class="text-xs font-semibold uppercase tracking-widest text-accent">{c.k}</p>
            <p class="mt-0.5 text-sm font-medium text-ink">{c.v}</p>
          </div>
        </div>
      </li>
    ))}
  </ul>
</section>

<script>
  import { roles } from '../data/site';

  const el = document.getElementById('typewriter-text');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (el && !reduce) {
    let roleIdx = 0;
    let charIdx = roles[0].length;
    let deleting = false;

    const tick = () => {
      const current = roles[roleIdx];
      el.textContent = current.slice(0, charIdx);
      if (!deleting) {
        if (charIdx === current.length) {
          setTimeout(() => { deleting = true; tick(); }, 2200);
          return;
        }
        charIdx++;
        setTimeout(tick, 80);
      } else {
        if (charIdx === 0) {
          deleting = false;
          roleIdx = (roleIdx + 1) % roles.length;
          setTimeout(tick, 300);
          return;
        }
        charIdx--;
        setTimeout(tick, 45);
      }
    };
    // Start once the hero has faded in
    setTimeout(tick, 1800);
  }
</script>
