---
import Logo from './Logo.astro';
import SocialPill from './SocialPill.astro';
import { navLinks, site } from '../data/site';
---

<header
  id="site-nav"
  class="sticky top-0 z-50 border-b border-line/60 bg-canvas/80 backdrop-blur-md supports-[backdrop-filter]:bg-canvas/70"
>
  <nav aria-label="Primary" class="flex h-16 items-center justify-between gap-3 px-4">
    <a href="#top" class="flex items-center gap-2.5 rounded-lg lg:w-[190px]" aria-label={`${site.name}, back to top`}>
      <Logo size={28} />
      <span class="hidden text-sm font-medium tracking-tight text-ink sm:inline">{site.name}</span>
    </a>

    <!-- Desktop: centred pill -->
    <ul class="hidden items-center gap-1 rounded-full border border-line bg-canvas/60 px-2 py-1 text-sm lg:flex">
      {navLinks.map((l) => (
        <li>
          <a href={l.href} class="nav-link rounded-full px-3 py-1 font-medium text-ink-2 transition-colors hover:text-ink">
            {l.name}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-2 lg:w-[190px] lg:justify-end">
      <button
        type="button"
        data-theme-toggle
        class="grid h-9 w-9 place-items-center rounded-full border border-line bg-canvas text-ink-2 transition-colors hover:border-accent hover:text-accent"
        aria-label="Switch to dark mode"
        aria-pressed="false"
      >
        <!-- Sun (visible in dark mode) -->
        <svg class="hidden h-4 w-4 dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364-.707-.707M6.343 6.343l-.707-.707m12.728 0-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0z" />
        </svg>
        <!-- Moon (visible in light mode) -->
        <svg class="block h-4 w-4 dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 0 1 8.646 3.646 9.003 9.003 0 0 0 12 21a9.003 9.003 0 0 0 8.354-5.646z" />
        </svg>
      </button>

      <SocialPill class="hidden sm:flex" />

      <button
        type="button"
        id="menu-btn"
        class="grid h-9 w-9 place-items-center rounded-full border border-line bg-canvas text-ink lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M9 12h11M14 17h6" />
        </svg>
      </button>
    </div>
  </nav>

</header>

<!-- Mobile menu (full-screen sheet) -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-[60] hidden h-dvh bg-canvas lg:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Site menu"
>
  <div class="flex h-16 items-center justify-between border-b border-line/60 px-4">
    <a href="#top" class="menu-link flex items-center gap-2.5" aria-label="Back to top">
      <Logo size={28} />
      <span class="text-sm font-medium tracking-tight text-ink">{site.name}</span>
    </a>
    <button
      type="button"
      id="menu-close"
      class="grid h-9 w-9 place-items-center rounded-full border border-line text-ink"
      aria-label="Close menu"
    >
      <svg class="h-5 w-5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path d="M5.28 4.22a.75.75 0 0 0-1.06 1.06L6.94 8l-2.72 2.72a.75.75 0 1 0 1.06 1.06L8 9.06l2.72 2.72a.75.75 0 1 0 1.06-1.06L9.06 8l2.72-2.72a.75.75 0 0 0-1.06-1.06L8 6.94 5.28 4.22Z" />
      </svg>
    </button>
  </div>
  <ul class="grid gap-1 px-2 py-3">
    {navLinks.map((l) => (
      <li>
        <a href={l.href} class="menu-link block rounded-lg px-3 py-2 text-xl/9 font-medium text-ink-2 hover:bg-surface hover:text-ink">
          {l.name}
        </a>
      </li>
    ))}
  </ul>
  <div class="px-5 pt-4">
    <SocialPill class="inline-flex" />
  </div>
</div>


<script>
  // ── Theme toggle ──
  const root = document.documentElement;
  const toggles = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
  const syncToggle = () => {
    const dark = root.classList.contains('dark');
    toggles.forEach((b) => {
      b.setAttribute('aria-pressed', String(dark));
      b.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
    });
  };
  syncToggle();
  toggles.forEach((b) =>
    b.addEventListener('click', () => {
      const dark = root.classList.toggle('dark');
      try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
      syncToggle();
    })
  );

  // ── Mobile menu ──
  const menu = document.getElementById('mobile-menu');
  const openBtn = document.getElementById('menu-btn');
  const closeBtn = document.getElementById('menu-close');

  function setMenu(open: boolean) {
    if (!menu || !openBtn) return;
    menu.classList.toggle('hidden', !open);
    document.body.classList.toggle('menu-open', open);
    openBtn.setAttribute('aria-expanded', String(open));
    if (open) closeBtn?.focus();
    else openBtn.focus({ preventScroll: true });
  }
  openBtn?.addEventListener('click', () => setMenu(true));
  closeBtn?.addEventListener('click', () => setMenu(false));
  menu?.querySelectorAll('.menu-link').forEach((a) =>
    a.addEventListener('click', () => {
      menu.classList.add('hidden');
      document.body.classList.remove('menu-open');
      openBtn?.setAttribute('aria-expanded', 'false');
    })
  );
  document.addEventListener('keydown', (e) => {
    if (!menu || menu.classList.contains('hidden')) return;
    if (e.key === 'Escape') setMenu(false);
    // Keep focus inside the open dialog
    if (e.key === 'Tab') {
      const f = Array.from(menu.querySelectorAll<HTMLElement>('a, button'));
      const first = f[0], last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
  });

  // ── Active section highlight ──
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.nav-link'));
  const sections = links
    .map((l) => document.getElementById(l.getAttribute('href')!.slice(1)))
    .filter(Boolean) as HTMLElement[];

  if ('IntersectionObserver' in window && sections.length) {
    const visible = new Map<string, boolean>();
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => visible.set(e.target.id, e.isIntersecting));
        // First visible section in document order wins
        const current = sections.find((s) => visible.get(s.id))?.id;
        links.forEach((l) => {
          const on = l.getAttribute('href') === `#${current}`;
          l.classList.toggle('active', on);
          if (on) l.setAttribute('aria-current', 'true');
          else l.removeAttribute('aria-current');
        });
      },
      { rootMargin: '-45% 0px -50% 0px' }
    );
    sections.forEach((s) => io.observe(s));
  }
</script>

<style>
  .nav-link.active {
    color: var(--c-ink);
    background-color: var(--c-surface);
    box-shadow: 0 0 0 1px var(--c-line);
  }
</style>
