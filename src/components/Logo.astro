---
// "IK" monogram — same mark as /favicon.svg, drawn inline so it scales crisply.
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className = '' } = Astro.props;
const gid = `ik-grad-${size}`;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 32 32"
  class={className}
  aria-hidden="true"
>
  <defs>
    <linearGradient id={gid} x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#818cf8" />
      <stop offset="100%" stop-color="#67e8f9" />
    </linearGradient>
  </defs>
  <rect width="32" height="32" rx="8" fill="#0f0e17" />
  <text
    x="16"
    y="21.5"
    text-anchor="middle"
    font-family="Geist, Inter, sans-serif"
    font-size="14"
    font-weight="700"
    fill={`url(#${gid})`}>IK</text>
</svg>
