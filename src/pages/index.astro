---
import '../styles/global.css';

const timeline = [
  {
    year: 'Nov 2021 – Nov 2024',
    role: 'Software Engineer',
    org: 'SpaceDot (student space team)',
    description: 'Built the Angular operator UI to monitor and control the team\'s satellite data transmission system. Containerized the application with Docker, cutting deployment time by 40%.',
    tags: ['Angular', 'TypeScript', 'Docker'],
  },
  {
    year: 'Jul 2024 – Sept 2024',
    role: 'Software Engineer Intern',
    org: 'Technology Without Borders',
    description: 'Created B2B apps with Microsoft PowerApps, reducing processing time by 98%. Designed an event management app with Flutter & Dart, and built a Chrome extension using Plasmo and Firebase.',
    tags: ['Flutter', 'Dart', 'PowerApps', 'Firebase'],
  },
  {
    year: 'Jul 2025 – Feb 2026',
    role: 'MLOps Engineer',
    org: 'ICS, FORTH',
    description: 'Trained a semantic segmentation model for river regions (Dice 0.91). Deployed the data pipeline on Kubernetes with Kafka, MinIO, PostgreSQL, and Grafana. Built a full-stack web app for real-time model monitoring.',
    tags: ['MLOps', 'Kubernetes', 'Kafka', 'Grafana'],
  },
  {
    year: 'Feb 2026 – Present',
    role: 'Software Engineer',
    org: 'IIT, NCSR "Demokritos"',
    description: 'Deployed Open OnDemand with Keycloak OIDC on Rocky Linux 9, exposing Jupyter, VSCode, and RStudio as Apptainer apps. Authored Ansible playbooks provisioning a 3-node Slurm cluster end-to-end. Operationalized Zammad, Outline, and Plane via Docker Compose.',
    tags: ['Slurm', 'Ansible', 'Open OnDemand', 'Keycloak', 'Apptainer'],
  },
];

const projects = [
  {
    name: 'Beaver',
    description: 'A declarative DSL for building ML pipelines on live data streams. Write .bvr files — Beaver generates Python that wires Kafka, Quix Streams, River, and Plotly/Dash together. Includes static validation, model analysis, a unified CLI, and detailed error reporting. Developed as my M.Eng thesis.',
    tags: ['TextX', 'Jinja', 'Kafka', 'Quix Streams', 'River', 'Python', 'Docker'],
    status: 'live',
    icon: '🦫',
  },
  {
    name: 'ESP32 Greenhouse Monitor',
    description: 'Standalone greenhouse monitor — no PC required after setup. DHT22 reads temperature and humidity; two potentiometers set alert thresholds; readings display on a 16×2 LCD. The ESP32 hosts its own web dashboard and fires Telegram alerts when thresholds are crossed.',
    tags: ['ESP32', 'C++', 'DHT22', 'Telegram API', 'Embedded'],
    status: 'live',
    icon: '🌱',
  },
  {
    name: 'SixPath',
    description: 'Self-hosted professional network graph tool. Maps people, projects, and relationships through an interactive graph interface.',
    tags: ['TypeScript', 'Graph', 'Self-hosted'],
    status: 'live',
    icon: '🕸️',
  },
  {
    name: 'Pharos AI Factory',
    description: 'EU-funded Greek national AI infrastructure. Building the platform layer connecting researchers to compute — HPC, Open OnDemand, identity management, and cloud-native services.',
    tags: ['EU', 'AI', 'HPC', 'Infrastructure'],
    status: 'building',
    icon: '🏛️',
  },
];

const skills = [
  'Python', 'TypeScript', 'C++', 'Java', 'Dart', 'Bash',
  'Docker', 'Kubernetes', 'Ansible', 'Slurm', 'Apptainer',
  'Kafka', 'Quix Streams', 'PostgreSQL', 'MinIO', 'Firebase',
  'Keycloak', 'OpenLDAP', 'Traefik', 'Tailscale',
  'Grafana', 'Prometheus', 'Zammad',
];

const homelabCategories = [
  {
    name: 'Media',
    cardClass: 'border-violet-200 bg-violet-50',
    titleClass: 'text-violet-600',
    chipClass: 'bg-violet-100 text-violet-700 border-violet-200',
    dotClass: 'bg-violet-400',
    col: 'md:col-span-1',
    apps: ['Jellyfin', 'Sonarr', 'Radarr', 'Prowlarr', 'Jellyseerr', 'qBittorrent', 'Recommendarr'],
  },
  {
    name: 'Photos & Docs',
    cardClass: 'border-sky-200 bg-sky-50',
    titleClass: 'text-sky-600',
    chipClass: 'bg-sky-100 text-sky-700 border-sky-200',
    dotClass: 'bg-sky-400',
    col: 'md:col-span-1',
    apps: ['Immich', 'Paperless', 'BookLore', 'Syncthing', 'File Browser', 'Karakeep'],
  },
  {
    name: 'Infrastructure',
    cardClass: 'border-amber-200 bg-amber-50',
    titleClass: 'text-amber-600',
    chipClass: 'bg-amber-100 text-amber-700 border-amber-200',
    dotClass: 'bg-amber-400',
    col: 'md:col-span-2',
    apps: ['Traefik', 'Pi-hole', 'Portainer', 'Beszel', 'Uptime Kuma', 'n8n'],
  },
  {
    name: 'Finance',
    cardClass: 'border-emerald-200 bg-emerald-50',
    titleClass: 'text-emerald-600',
    chipClass: 'bg-emerald-100 text-emerald-700 border-emerald-200',
    dotClass: 'bg-emerald-400',
    col: 'md:col-span-1',
    apps: ['Actual Budget', 'Ghostfolio'],
  },
  {
    name: 'AI & Storage',
    cardClass: 'border-indigo-200 bg-indigo-50',
    titleClass: 'text-indigo-600',
    chipClass: 'bg-indigo-100 text-indigo-700 border-indigo-200',
    dotClass: 'bg-indigo-400',
    col: 'md:col-span-1',
    apps: ['Open WebUI', 'OpenMediaVault'],
  },
];

const floatDurations = [3.2, 3.7, 4.3, 3.5, 4.8];
const floatDelays    = [0, 0.6, 1.2, 1.8, 0.4, 2.1, 0.9, 1.5, 0.2, 1.9];

const stats = [
  { value: 25, suffix: '+', label: 'Self-hosted services' },
  //{ value: 3, suffix: '', label: 'Node HPC cluster' },
  { value: 4, suffix: '+', label: 'Years engineering' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iasonas Kakandris — Software Engineer</title>
    <meta name="description" content="Software Engineer specializing in HPC, MLOps, and cloud-native infrastructure." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body style="font-family: 'Inter', sans-serif;">

    <!-- Cursor glow -->
    <div id="cursor-glow"
         style="position:fixed;width:500px;height:500px;border-radius:50%;background:radial-gradient(circle,rgba(99,102,241,0.13) 0%,transparent 65%);pointer-events:none;z-index:1;opacity:0;transition:opacity 0.5s ease;transform:translate(-50%,-50%);left:0;top:0;">
    </div>

    <!-- Sticky nav -->
    <nav id="site-nav" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
      <div class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
        <a href="#" class="text-white font-semibold text-sm tracking-widest uppercase opacity-90 hover:opacity-100 transition-opacity">IK</a>
        <div class="hidden sm:flex items-center gap-8">
          <a href="#about"           class="nav-link">About</a>
          <a href="#cluster-section" class="nav-link">Cluster</a>
          {/* HPC nav link — bring back once the Slurm section is finished
          <a href="#slurm-section"   class="nav-link">HPC</a> */}
          <a href="#journey"         class="nav-link">Journey</a>
          <a href="#projects"        class="nav-link">Projects</a>
          <a href="#homelab"         class="nav-link">Homelab</a>
          <a href="#cv"              class="nav-link">CV</a>
          <a href="#contact"         class="nav-link">Contact</a>
        </div>
      </div>
    </nav>

    <!-- ── HERO ── -->
    <section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-[#0f0e17]">
      <!-- Aurora blobs -->
      <div class="aurora-blob"></div>
      <div class="aurora-blob"></div>
      <div class="aurora-blob"></div>

      <!-- Content -->
      <div class="relative z-10 text-center px-6 max-w-3xl mx-auto">
        <p class="text-cyan-400 text-sm font-medium tracking-widest uppercase mb-4 opacity-0 animate-[fadeDown_0.8s_ease_0.2s_forwards]">
          <span id="typewriter-text">Software Engineer</span><span class="tw-cursor"></span>
        </p>
        <h1 class="text-white text-5xl sm:text-7xl font-bold tracking-tight mb-6 opacity-0 animate-[fadeDown_0.8s_ease_0.4s_forwards]">
          Iasonas<br />
          <span class="bg-gradient-to-r from-indigo-400 via-purple-400 to-cyan-400 bg-clip-text text-transparent">
            Kakandris
          </span>
        </h1>
        <p class="text-slate-300 text-lg sm:text-xl leading-relaxed mb-10 opacity-0 animate-[fadeDown_0.8s_ease_0.6s_forwards]">
          Building infrastructure where AI research meets compute —<br class="hidden sm:block" />
          HPC clusters, MLOps pipelines, and self-hosted systems.
        </p>
        <div class="flex flex-wrap gap-4 justify-center opacity-0 animate-[fadeDown_0.8s_ease_0.8s_forwards]">
          <a href="#journey"
             class="px-6 py-3 rounded-full bg-indigo-500 hover:bg-indigo-400 text-white font-medium transition-all duration-200 hover:-translate-y-0.5">
            My Journey
          </a>
          <a href="mailto:ikakandris@gmail.com"
             class="px-6 py-3 rounded-full border border-white/20 hover:border-white/50 text-white font-medium transition-all duration-200 hover:-translate-y-0.5">
            Get in touch
          </a>
        </div>
      </div>

      <!-- Scroll indicator — direct child of section so absolute positions to hero bottom -->
      <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-0 animate-[fadeDown_1s_ease_1.2s_forwards]">
        <div class="w-px h-10 bg-gradient-to-b from-white/40 to-transparent"></div>
        <p class="text-white/30 text-xs tracking-widest uppercase">Scroll</p>
      </div>
    </section>

    <!-- ── ABOUT ── -->
    <section id="about" class="py-28 px-6 max-w-4xl mx-auto">

      <!-- Stat counters -->
      <div class="reveal flex flex-wrap justify-center gap-16 mb-20 text-center">
        {stats.map(s => (
          <div>
            <p class="text-4xl sm:text-5xl font-bold text-indigo-500 tabular-nums">
              <span class="stat-counter" data-target={s.value}>0</span>{s.suffix}
            </p>
            <p class="text-slate-500 text-sm mt-1">{s.label}</p>
          </div>
        ))}
      </div>

      <div class="reveal grid md:grid-cols-2 gap-16 items-center">
        <div>
          <p class="text-indigo-500 text-sm font-semibold tracking-widest uppercase mb-3">About</p>
          <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-6 leading-tight">
            Infrastructure engineer<br />with a builder's mindset
          </h2>
          <p class="text-slate-600 leading-relaxed mb-4">
            I'm a Software Engineer at IIT, NCSR "Demokritos", working on Pharos — the Greek AI Factory, an EU-funded initiative bringing national AI computing infrastructure to researchers across Greece.
          </p>
          <p class="text-slate-600 leading-relaxed mb-4">
            My work spans HPC cluster administration (Slurm, Open OnDemand, Ansible), MLOps platform engineering, and a self-hosted homelab running 20+ services behind Traefik. I hold an M.Eng from AUTh with a thesis on a declarative DSL for streaming ML pipelines.
          </p>
          <p class="text-slate-600 leading-relaxed">
            Mensa member. Fluent in Greek, English, Italian, and German.
          </p>
        </div>
        <div id="skills-container" style="transition-delay: 0.15s">
          <p class="text-slate-500 text-sm font-medium mb-4 uppercase tracking-widest">Stack</p>
          <div class="flex flex-wrap gap-2">
            {skills.map((s, i) => (
              <span
                class="chip-reveal px-3 py-1.5 rounded-full bg-slate-100 text-slate-700 text-sm font-medium hover:bg-indigo-50 hover:text-indigo-700 transition-colors duration-200 cursor-default"
                style={`transition-delay: ${i * 0.045}s`}
              >
                {s}
              </span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ── CLUSTER VIZ ── -->
    <section id="cluster-section" class="py-24 bg-[#0f0e17] relative overflow-hidden">
      <div class="absolute inset-0 pointer-events-none">
        <div class="absolute w-[500px] h-[500px] rounded-full bg-indigo-700 blur-[140px] opacity-10 top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2"></div>
      </div>
      <div class="relative z-10 max-w-4xl mx-auto px-6">
        <div class="reveal text-center mb-10">
          <p class="text-cyan-400 text-sm font-semibold tracking-widest uppercase mb-3">Infrastructure</p>
          <h2 class="text-3xl sm:text-4xl font-bold text-white">Kubernetes cluster</h2>
          <p class="text-slate-500 mt-3 text-sm max-w-md mx-auto">
            Every request passes through Authentik, ztunnel mTLS, and Kyverno policy before it reaches a pod
          </p>
        </div>

        <div class="reveal flex justify-center">
          <svg id="cluster-svg" viewBox="0 0 900 260" class="w-full max-w-2xl" aria-hidden="true">
            <defs>
              <filter id="pkt-glow" x="-100%" y="-100%" width="300%" height="300%">
                <feGaussianBlur stdDeviation="3" result="blur"/>
                <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
              </filter>
              <filter id="node-glow-f" x="-50%" y="-50%" width="200%" height="200%">
                <feGaussianBlur stdDeviation="9" result="blur"/>
                <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
              </filter>
            </defs>

            <!-- Wire -->
            <line x1="90" y1="130" x2="794" y2="130" stroke="#6366f1" stroke-width="1.2" opacity="0.2"/>

            <!-- Traveling request/response token -->
            <polygon id="k8s-token" points="-6,-4 6,0 -6,4" fill="#818cf8" filter="url(#pkt-glow)" opacity="0.95"/>

            <!-- ── client ── -->
            <g transform="translate(70,130)">
              <circle class="client-ring" r="27" fill="none" stroke="#67e8f9" stroke-width="1.5" opacity="0"/>
              <circle r="20" fill="rgba(15,14,23,0.97)" stroke="#64748b" stroke-width="1.5"/>
              <circle cx="0" cy="-3" r="3.4" fill="none" stroke="#94a3b8" stroke-width="1.3"/>
              <path d="M-7,7 a7,6.5 0 0 1 14,0 Z" fill="none" stroke="#94a3b8" stroke-width="1.3"/>
              <text y="34" text-anchor="middle" fill="#94a3b8" font-size="12" font-family="Inter,sans-serif">client</text>
            </g>

            <!-- ── Authentik (auth gate) ── -->
            <g class="k8s-gate" data-gate="authentik" transform="translate(255,130)">
              <circle class="gate-ring" r="34" fill="none" stroke="#475569" stroke-width="1.5" opacity="0.35"/>
              <circle r="26" fill="rgba(15,14,23,0.97)" stroke="#818cf8" stroke-width="1.5" filter="url(#node-glow-f)"/>
              <!-- shield icon -->
              <path d="M0,-12 L10,-7 V2 C10,9 5,13 0,15 C-5,13 -10,9 -10,2 V-7 Z" fill="rgba(129,140,248,0.14)" stroke="#818cf8" stroke-width="1.4"/>
              <circle cx="0" cy="-1" r="2.4" fill="none" stroke="#818cf8" stroke-width="1.2"/>
              <line x1="0" y1="1.4" x2="0" y2="5" stroke="#818cf8" stroke-width="1.2"/>
              <text y="46" text-anchor="middle" fill="#94a3b8" font-size="12" font-family="Inter,sans-serif">Authentik</text>
              <text y="59" text-anchor="middle" fill="#64748b" font-size="9" font-family="Inter,sans-serif">auth</text>
              <g class="gate-check" opacity="0" transform="translate(20,-20)">
                <circle r="8" fill="#10b981"/>
                <path d="M-3.5,0 L-1,3 L4,-3.5" fill="none" stroke="white" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </g>
            </g>

            <!-- ── ztunnel (mTLS gate) ── -->
            <g class="k8s-gate" data-gate="ztunnel" transform="translate(440,130)">
              <circle class="gate-ring" r="34" fill="none" stroke="#475569" stroke-width="1.5" opacity="0.35"/>
              <circle r="26" fill="rgba(15,14,23,0.97)" stroke="#67e8f9" stroke-width="1.5" filter="url(#node-glow-f)"/>
              <!-- padlock icon -->
              <rect x="-8" y="-2" width="16" height="13" rx="2.5" fill="rgba(103,232,249,0.14)" stroke="#67e8f9" stroke-width="1.4"/>
              <path d="M-5,-2 V-6 a5,5 0 0 1 10,0 V-2" fill="none" stroke="#67e8f9" stroke-width="1.4"/>
              <circle cx="0" cy="4" r="1.6" fill="#67e8f9"/>
              <text y="46" text-anchor="middle" fill="#94a3b8" font-size="12" font-family="Inter,sans-serif">ztunnel</text>
              <text y="59" text-anchor="middle" fill="#64748b" font-size="9" font-family="Inter,sans-serif">mTLS · L4</text>
              <g class="gate-check" opacity="0" transform="translate(20,-20)">
                <circle r="8" fill="#10b981"/>
                <path d="M-3.5,0 L-1,3 L4,-3.5" fill="none" stroke="white" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </g>
            </g>

            <!-- ── Kyverno (policy gate) ── -->
            <g class="k8s-gate" data-gate="kyverno" transform="translate(625,130)">
              <circle class="gate-ring" r="34" fill="none" stroke="#475569" stroke-width="1.5" opacity="0.35"/>
              <circle r="26" fill="rgba(15,14,23,0.97)" stroke="#34d399" stroke-width="1.5" filter="url(#node-glow-f)"/>
              <!-- policy / clipboard icon -->
              <rect x="-8" y="-11" width="16" height="21" rx="2.5" fill="rgba(52,211,153,0.14)" stroke="#34d399" stroke-width="1.4"/>
              <rect x="-4" y="-13" width="8" height="3.5" rx="1" fill="#34d399"/>
              <path d="M-4.5,0 L-1.5,3 L4.5,-4" fill="none" stroke="#34d399" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
              <text y="46" text-anchor="middle" fill="#94a3b8" font-size="12" font-family="Inter,sans-serif">Kyverno</text>
              <text y="59" text-anchor="middle" fill="#64748b" font-size="9" font-family="Inter,sans-serif">policy</text>
              <g class="gate-check" opacity="0" transform="translate(20,-20)">
                <circle r="8" fill="#10b981"/>
                <path d="M-3.5,0 L-1,3 L4,-3.5" fill="none" stroke="white" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </g>
            </g>

            <!-- ── pod ── -->
            <g transform="translate(820,130)">
              <text class="pod-status" y="-40" text-anchor="middle" fill="#34d399" font-size="11" font-weight="600" opacity="0" font-family="Inter,sans-serif">200 OK</text>
              <circle r="32" fill="rgba(129,140,248,0.06)" stroke="rgba(129,140,248,0.16)" stroke-width="1"/>
              <circle r="24" fill="rgba(15,14,23,0.97)" stroke="rgba(129,140,248,0.7)" stroke-width="1.5"/>
              <!-- container/hexagon icon -->
              <path d="M0,-11 L9.5,-5.5 V5.5 L0,11 L-9.5,5.5 V-5.5 Z" fill="rgba(129,140,248,0.16)" stroke="#818cf8" stroke-width="1.3"/>
              <text y="44" text-anchor="middle" fill="#94a3b8" font-size="12" font-family="Inter,sans-serif">pod</text>
            </g>
          </svg>
        </div>

        <!-- Tech tags -->
        <div class="reveal flex flex-wrap justify-center gap-2 mt-10">
          {['k3s', 'Istio ambient', 'ArgoCD', 'cert-manager', 'Kyverno', 'Authentik', 'Sealed Secrets', 'Trivy'].map(t => (
            <span class="px-3 py-1.5 rounded-full bg-white/5 border border-white/10 text-slate-400 text-xs font-medium hover:border-cyan-400/40 hover:text-cyan-400 transition-colors duration-200 cursor-default">
              {t}
            </span>
          ))}
        </div>
      </div>
    </section>

    {/* SLURM CLUSTER VIZ — hidden until the 3-node HPC cluster is finished; bring back by removing this comment wrapper
    <!-- ── SLURM CLUSTER VIZ ── -->
    <section id="slurm-section" class="py-24 bg-[#faf9f6] relative overflow-hidden">
      <div class="absolute inset-0 pointer-events-none">
        <div class="absolute w-[500px] h-[500px] rounded-full bg-amber-100 blur-[140px] opacity-60 top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2"></div>
      </div>
      <div class="relative z-10 max-w-4xl mx-auto px-6">
        <div class="reveal text-center mb-10">
          <p class="text-amber-500 text-sm font-semibold tracking-widest uppercase mb-3">HPC</p>
          <h2 class="text-3xl sm:text-4xl font-bold text-slate-900">Slurm cluster</h2>
          <p class="text-slate-500 mt-3 text-sm max-w-sm mx-auto">
            3-node cluster at NCSR "Demokritos" — Open OnDemand exposes Jupyter, VSCode &amp; RStudio as Apptainer apps
          </p>
        </div>

        <div class="reveal flex justify-center">
          <svg id="slurm-svg" viewBox="0 0 800 400" class="w-full max-w-xl" aria-hidden="true">
            <defs>
              <filter id="slurm-pkt-glow" x="-100%" y="-100%" width="300%" height="300%">
                <feGaussianBlur stdDeviation="3" result="blur"/>
                <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
              </filter>
              <filter id="slurm-node-glow" x="-50%" y="-50%" width="200%" height="200%">
                <feGaussianBlur stdDeviation="8" result="blur"/>
                <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
              </filter>
            </defs>

            <!-- Dispatch edges: scheduler → compute nodes only -->
            <line x1="400" y1="88"  x2="185" y2="280" stroke="#f59e0b" stroke-width="1.2" opacity="0.3"/>
            <line x1="400" y1="88"  x2="615" y2="280" stroke="#f59e0b" stroke-width="1.2" opacity="0.3"/>

            <!-- Pending-job queue slots (decorative capacity markers either side of the scheduler) -->
            <rect class="slurm-slot" x="48"  y="45" width="14" height="10" rx="2" fill="none" stroke="rgba(245,158,11,0.35)" stroke-width="1"/>
            <rect class="slurm-slot" x="88"  y="45" width="14" height="10" rx="2" fill="none" stroke="rgba(245,158,11,0.35)" stroke-width="1"/>
            <rect class="slurm-slot" x="128" y="45" width="14" height="10" rx="2" fill="none" stroke="rgba(245,158,11,0.35)" stroke-width="1"/>
            <rect class="slurm-slot" x="658" y="45" width="14" height="10" rx="2" fill="none" stroke="rgba(245,158,11,0.35)" stroke-width="1"/>
            <rect class="slurm-slot" x="698" y="45" width="14" height="10" rx="2" fill="none" stroke="rgba(245,158,11,0.35)" stroke-width="1"/>
            <rect class="slurm-slot" x="738" y="45" width="14" height="10" rx="2" fill="none" stroke="rgba(245,158,11,0.35)" stroke-width="1"/>

            <!-- 6 job cards: queue → scheduler → compute node → run → repeat -->
