        });

        function lerp(a: {x:number,y:number}, b: {x:number,y:number}, u: number) {
          return { x: a.x + (b.x - a.x) * u, y: a.y + (b.y - a.y) * u };
        }

        const start = performance.now();

        function frame(now: number) {
          jobs.forEach((job, i) => {
            const p = (((now - start) + job.offset) % job.duration) / job.duration;
            const slotPos = queueSlots[job.node][job.slot];
            const nPos = nodePos[job.node];
            const jobEl = jobEls[i];
            const coreEl = coreByNodeSlot.get(`${job.node}:${job.slot}`);

            let pos = slotPos;
            let visible = true;

            if (p < P_QUEUED_END) {
              pos = slotPos;
            } else if (p < P_TRAVEL1_END) {
              const u = (p - P_QUEUED_END) / (P_TRAVEL1_END - P_QUEUED_END);
              pos = lerp(slotPos, login, u);
            } else if (p < P_TRAVEL2_END) {
              const u = (p - P_TRAVEL1_END) / (P_TRAVEL2_END - P_TRAVEL1_END);
              pos = lerp(login, nPos, u);
            } else {
              visible = false; // running on the node — represented by the core cell instead
            }

            if (jobEl) {
              jobEl.setAttribute('x', (pos.x - 5).toFixed(1));
              jobEl.setAttribute('y', (pos.y - 3.5).toFixed(1));
              jobEl.setAttribute('opacity', visible ? '0.92' : '0');
            }
            if (coreEl) {
              coreEl.setAttribute('fill-opacity', visible ? '0' : '0.85');
            }
          });
          requestAnimationFrame(frame);
        }

        new IntersectionObserver((entries, obs) => {
          if (entries[0].isIntersecting) { requestAnimationFrame(frame); obs.disconnect(); }
        }, { threshold: 0.2 }).observe(document.getElementById('slurm-section')!);
      })();
      */

      // ── Sticky nav ──
      const nav = document.getElementById('site-nav') as HTMLElement;
      const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.nav-link'));

      window.addEventListener('scroll', () => {
        if (window.scrollY > 60) {
          nav.style.cssText += 'background:rgba(15,14,23,0.88);backdrop-filter:blur(14px);border-bottom:1px solid rgba(255,255,255,0.07);';
        } else {
          nav.style.cssText += 'background:transparent;backdrop-filter:none;border-bottom:1px solid transparent;';
        }
      }, { passive: true });

      // Active section highlight
      const sectionIds = ['about', 'cluster-section', 'journey', 'projects', 'homelab', 'cv', 'contact']; // 'slurm-section' omitted while that section is hidden
      const sectionEls = sectionIds.map(id => document.getElementById(id)).filter(Boolean) as HTMLElement[];

      const navObserver = new IntersectionObserver(entries => {
        entries.forEach(e => {
          const link = navLinks.find(l => l.getAttribute('href') === '#' + e.target.id);
          if (link) link.classList.toggle('active', e.isIntersecting);
        });
      }, { threshold: 0.35 });
      sectionEls.forEach(el => navObserver.observe(el));

      // ── Cursor glow ──
      const glow = document.getElementById('cursor-glow') as HTMLElement;
      let gx = 0, gy = 0, mx = 0, my = 0;

      window.addEventListener('mousemove', e => {
        mx = e.clientX; my = e.clientY;
        glow.style.opacity = '1';
      }, { passive: true });
      window.addEventListener('mouseleave', () => { glow.style.opacity = '0'; }, { passive: true });

      (function lerpGlow() {
        gx += (mx - gx) * 0.08;
        gy += (my - gy) * 0.08;
        glow.style.left = gx + 'px';
        glow.style.top  = gy + 'px';
        requestAnimationFrame(lerpGlow);
      })();

      // ── Kubernetes animation: request journey through Authentik → ztunnel → Kyverno → pod ──
      (function () {
        const svg = document.getElementById('cluster-svg');
        if (!svg) return;

        const X_CLIENT = 70, X_AUTH = 255, X_ZTUNNEL = 440, X_KYVERNO = 625, X_POD = 820;
        const Y = 130;
        const SPAN = X_POD - X_CLIENT;

        // Cycle phases, as fractions of the total loop duration T
        const T = 7000;
        const P_FWD_END    = 0.42; // client → pod (through all 3 gates)
        const P_POD_END    = 0.47; // brief "200 OK" dwell at the pod
        const P_BACK_END   = 0.89; // pod → client (ztunnel only — auth/policy don't re-check responses)
        // P_BACK_END → 1.0     : brief dwell at the client before the next request

        const frac = (x: number) => (x - X_CLIENT) / SPAN;
        const T_AUTH    = frac(X_AUTH)    * P_FWD_END;
        const T_ZTUNNEL = frac(X_ZTUNNEL) * P_FWD_END;
        const T_KYVERNO = frac(X_KYVERNO) * P_FWD_END;
        const T_ZTUNNEL_BACK = P_POD_END + (1 - frac(X_ZTUNNEL)) * (P_BACK_END - P_POD_END);

        const token = document.getElementById('k8s-token');
        const podStatus = svg.querySelector('.pod-status');
        const clientRing = svg.querySelector('.client-ring');
        const gates = Array.from(svg.querySelectorAll('.k8s-gate')).map(g => ({
          name: g.getAttribute('data-gate'),
          ring: g.querySelector('.gate-ring') as SVGCircleElement,
          check: g.querySelector('.gate-check') as SVGGElement,
        }));

        function setGate(gate: typeof gates[number], active: boolean, pulse = false) {
          if (gate.ring) {
            gate.ring.setAttribute('stroke', active ? '#10b981' : '#475569');
            gate.ring.setAttribute('opacity', pulse ? '1' : active ? '0.85' : '0.35');
            gate.ring.setAttribute('stroke-width', pulse ? '2.5' : '1.5');
          }
          if (gate.check) gate.check.setAttribute('opacity', active ? '1' : '0');
        }

        const start = performance.now();

        function frame(now: number) {
          const t = ((now - start) % T) / T;

          let x = X_CLIENT, visible = true, forward = true;
          if (t < P_FWD_END) {
            x = X_CLIENT + SPAN * (t / P_FWD_END);
            forward = true;
          } else if (t < P_POD_END) {
            visible = false; // arriving — pod flashes its own status instead
          } else if (t < P_BACK_END) {
            const u = (t - P_POD_END) / (P_BACK_END - P_POD_END);
            x = X_POD - SPAN * u;
            forward = false;
          } else {
            visible = false; // delivered — brief pause before the next request
          }

          if (token) {
            token.setAttribute('transform', `translate(${x.toFixed(1)} ${Y}) rotate(${forward ? 0 : 180})`);
            token.setAttribute('fill', forward ? '#818cf8' : '#67e8f9');
            token.setAttribute('opacity', visible ? '0.95' : '0');
          }

          gates.forEach(gate => {
            if (gate.name === 'authentik') setGate(gate, t >= T_AUTH);
            else if (gate.name === 'kyverno') setGate(gate, t >= T_KYVERNO);
            else if (gate.name === 'ztunnel') {
              const active = t >= T_ZTUNNEL;
              const pulse = Math.abs(t - T_ZTUNNEL_BACK) < 0.02;
              setGate(gate, active, pulse);
            }
          });

          if (podStatus) podStatus.setAttribute('opacity', (t >= P_FWD_END && t < 0.55) ? '1' : '0');
          if (clientRing) clientRing.setAttribute('opacity', t >= P_BACK_END ? '0.8' : '0');

          requestAnimationFrame(frame);
        }

        const section = document.getElementById('cluster-section');
        if (section) {
          new IntersectionObserver((entries, obs) => {
            if (entries[0].isIntersecting) {
              requestAnimationFrame(frame);
              obs.disconnect();
            }
          }, { threshold: 0.2 }).observe(section);
        }
      })();
    </script>

    <style>
      @keyframes fadeDown {
        from { opacity: 0; transform: translateY(-16px); }
        to   { opacity: 1; transform: translateY(0); }
      }

      @keyframes bubble-float {
        0%, 100% { transform: translateY(0)    scale(1);    }
        50%       { transform: translateY(-8px) scale(1.04); }
      }

      .nav-link {
        font-size: 0.8125rem;
        font-weight: 500;
        color: rgba(255,255,255,0.55);
        letter-spacing: 0.04em;
        transition: color 0.2s ease;
        text-decoration: none;
        position: relative;
      }
      .nav-link::after {
        content: '';
        position: absolute;
        bottom: -3px;
        left: 0;
        width: 0;
        height: 1.5px;
        background: #818cf8;
        transition: width 0.25s ease;
      }
      .nav-link:hover,
      .nav-link.active {
        color: rgba(255,255,255,0.95);
      }
      .nav-link.active::after,
      .nav-link:hover::after {
        width: 100%;
      }
    </style>

  </body>
