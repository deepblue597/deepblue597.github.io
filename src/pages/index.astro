    <script>
      // ── Scroll reveal ──
      const revealObserver = new IntersectionObserver(
        (entries) => entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); }),
        { threshold: 0.1 }
      );
      document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));

      // ── Skill chip cascade ──
      const chipObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach(e => {
            if (e.isIntersecting) {
              e.target.querySelectorAll('.chip-reveal').forEach(chip => chip.classList.add('visible'));
              chipObserver.unobserve(e.target);
            }
          });
        },
        { threshold: 0.2 }
      );
      const skillsContainer = document.getElementById('skills-container');
      if (skillsContainer) chipObserver.observe(skillsContainer);

      // ── Timeline line draw ──
      const timelineLine = document.getElementById('timeline-line');
      if (timelineLine) {
        const lineObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach(e => {
              if (e.isIntersecting) {
                timelineLine.style.transform = 'scaleY(1)';
                lineObserver.unobserve(timelineLine);
              }
            });
          },
          { threshold: 0.1 }
        );
        lineObserver.observe(timelineLine);
      }

      // ── Stat counters ──
      function animateCounter(el: HTMLElement) {
        const target = parseInt(el.dataset.target ?? '0', 10);
        const duration = 1400;
        const start = performance.now();
        function step(now: number) {
          const progress = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = String(Math.floor(eased * target));
          if (progress < 1) requestAnimationFrame(step);
          else el.textContent = String(target);
        }
        requestAnimationFrame(step);
      }

      const counterObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach(e => {
            if (e.isIntersecting) {
              e.target.querySelectorAll<HTMLElement>('.stat-counter').forEach(animateCounter);
              counterObserver.unobserve(e.target);
            }
          });
        },
        { threshold: 0.5 }
      );
      document.querySelectorAll('.stat-counter').forEach(el => {
        const parent = el.closest('.reveal') ?? el.parentElement;
        if (parent) counterObserver.observe(parent);
      });

      // ── Typewriter ──
      const roles = ['Software Engineer', 'MLOps Engineer', 'HPC Enthusiast', 'Homelab Operator'];
      const twEl = document.getElementById('typewriter-text');
      if (twEl) {
        let roleIdx = 0;
        let charIdx = roles[0].length;
        let deleting = false;

        function tick() {
          const current = roles[roleIdx];
          if (!deleting) {
            twEl.textContent = current.slice(0, charIdx);
            if (charIdx === current.length) {
              setTimeout(() => { deleting = true; tick(); }, 2200);
              return;
            }
            charIdx++;
            setTimeout(tick, 80);
          } else {
            twEl.textContent = current.slice(0, charIdx);
            if (charIdx === 0) {
              deleting = false;
              roleIdx = (roleIdx + 1) % roles.length;
              charIdx = 0;
              setTimeout(tick, 300);
              return;
            }
            charIdx--;
            setTimeout(tick, 45);
          }
        }

        // Start after hero fade-in completes
        setTimeout(tick, 1800);
      }

      // ── Slurm cluster animation: job queue → scheduler → dispatch → run ──
      // Hidden while the Slurm section is commented out above; #slurm-svg won't exist so
      // this safely no-ops, but it's commented out too to avoid confusion. Bring it back
      // together with the section markup once the HPC cluster work is finished.
