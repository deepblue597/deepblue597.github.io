    </footer>

    <script>
      // ── Scroll reveal ──
      const revealObserver = new IntersectionObserver(
        (entries) => entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); }),
        { threshold: 0.1 }
      );
      document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));

      // ── Skill chip cascade ──
      const chipObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach(e => {
            if (e.isIntersecting) {
              e.target.querySelectorAll('.chip-reveal').forEach(chip => chip.classList.add('visible'));
              chipObserver.unobserve(e.target);
            }
          });
        },
        { threshold: 0.2 }
      );
      const skillsContainer = document.getElementById('skills-container');
      if (skillsContainer) chipObserver.observe(skillsContainer);

      // ── Timeline line draw ──
      const timelineLine = document.getElementById('timeline-line');
      if (timelineLine) {
        const lineObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach(e => {
              if (e.isIntersecting) {
                timelineLine.style.transform = 'scaleY(1)';
                lineObserver.unobserve(timelineLine);
              }
            });
          },
          { threshold: 0.1 }
        );
        lineObserver.observe(timelineLine);
      }

      // ── Stat counters ──
      function animateCounter(el: HTMLElement) {
        const target = parseInt(el.dataset.target ?? '0', 10);
        const duration = 1400;
        const start = performance.now();
        function step(now: number) {
          const progress = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = String(Math.floor(eased * target));
          if (progress < 1) requestAnimationFrame(step);
          else el.textContent = String(target);
        }
        requestAnimationFrame(step);
      }

      const counterObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach(e => {
            if (e.isIntersecting) {
              e.target.querySelectorAll<HTMLElement>('.stat-counter').forEach(animateCounter);
              counterObserver.unobserve(e.target);
            }
          });
        },
        { threshold: 0.5 }
      );
      document.querySelectorAll('.stat-counter').forEach(el => {
        const parent = el.closest('.reveal') ?? el.parentElement;
        if (parent) counterObserver.observe(parent);
      });

      // ── Typewriter ──
      const roles = ['Software Engineer', 'MLOps Engineer', 'HPC Enthusiast', 'Homelab Operator'];
      const twEl = document.getElementById('typewriter-text');
      if (twEl) {
        let roleIdx = 0;
        let charIdx = roles[0].length;
        let deleting = false;

        function tick() {
          const current = roles[roleIdx];
          if (!deleting) {
            twEl.textContent = current.slice(0, charIdx);
            if (charIdx === current.length) {
              setTimeout(() => { deleting = true; tick(); }, 2200);
              return;
            }
            charIdx++;
            setTimeout(tick, 80);
          } else {
            twEl.textContent = current.slice(0, charIdx);
            if (charIdx === 0) {
              deleting = false;
              roleIdx = (roleIdx + 1) % roles.length;
              charIdx = 0;
              setTimeout(tick, 300);
              return;
            }
            charIdx--;
            setTimeout(tick, 45);
          }
        }

        // Start after hero fade-in completes
        setTimeout(tick, 1800);
      }

      // ── Slurm cluster animation ──
      (function () {
        const svg = document.getElementById('slurm-svg');
        if (!svg) return;

        const nodes = [
          { x: 400, y: 88  },  // login/OOD
          { x: 185, y: 280 },  // compute-01
          { x: 615, y: 280 },  // compute-02
        ];

        const edgeDirs = [
          [0,1],[1,0],
          [0,2],[2,0],
          [1,2],[2,1],
        ];

        const state = edgeDirs.map(([from, to]) => ({
          from, to,
          t: Math.random(),
          speed: 0.003 + Math.random() * 0.003,
        }));

        const pktEls = Array.from(svg.querySelectorAll('.slurm-pkt')) as SVGCircleElement[];

        function frame() {
          state.forEach((p, i) => {
            p.t += p.speed;
            if (p.t > 1) p.t -= 1;
            const a = nodes[p.from], b = nodes[p.to];
            pktEls[i]?.setAttribute('cx', (a.x + (b.x - a.x) * p.t).toFixed(1));
            pktEls[i]?.setAttribute('cy', (a.y + (b.y - a.y) * p.t).toFixed(1));
            pktEls[i]?.setAttribute('opacity', '0.88');
          });
          requestAnimationFrame(frame);
        }

        new IntersectionObserver((entries, obs) => {
          if (entries[0].isIntersecting) { frame(); obs.disconnect(); }
        }, { threshold: 0.2 }).observe(document.getElementById('slurm-section')!);
      })();

      // ── Sticky nav ──
      const nav = document.getElementById('site-nav') as HTMLElement;
      const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.nav-link'));

      window.addEventListener('scroll', () => {
        if (window.scrollY > 60) {
          nav.style.cssText += 'background:rgba(15,14,23,0.88);backdrop-filter:blur(14px);border-bottom:1px solid rgba(255,255,255,0.07);';
        } else {
          nav.style.cssText += 'background:transparent;backdrop-filter:none;border-bottom:1px solid transparent;';
        }
      }, { passive: true });

      // Active section highlight
      const sectionIds = ['about', 'cluster-section', 'slurm-section', 'journey', 'projects', 'homelab', 'cv', 'contact'];
      const sectionEls = sectionIds.map(id => document.getElementById(id)).filter(Boolean) as HTMLElement[];

      const navObserver = new IntersectionObserver(entries => {
        entries.forEach(e => {
          const link = navLinks.find(l => l.getAttribute('href') === '#' + e.target.id);
          if (link) link.classList.toggle('active', e.isIntersecting);
        });
      }, { threshold: 0.35 });
      sectionEls.forEach(el => navObserver.observe(el));

      // ── Cursor glow ──
      const glow = document.getElementById('cursor-glow') as HTMLElement;
      let gx = 0, gy = 0, mx = 0, my = 0;

      window.addEventListener('mousemove', e => {
        mx = e.clientX; my = e.clientY;
        glow.style.opacity = '1';
      }, { passive: true });
      window.addEventListener('mouseleave', () => { glow.style.opacity = '0'; }, { passive: true });

      (function lerpGlow() {
        gx += (mx - gx) * 0.08;
        gy += (my - gy) * 0.08;
        glow.style.left = gx + 'px';
        glow.style.top  = gy + 'px';
        requestAnimationFrame(lerpGlow);
      })();

      // ── Kubernetes cluster animation ──
      (function () {
        const svg = document.getElementById('cluster-svg');
        if (!svg) return;

        const nodes = [
          { x: 450, y: 100 },  // control-plane
          { x: 140, y: 318 },  // worker-01
          { x: 450, y: 372 },  // worker-02
          { x: 760, y: 318 },  // worker-03
        ];

        // 12 directed edges (2 per undirected edge, both directions)
        const edgeDirs = [
          [0,1],[1,0],
          [0,2],[2,0],
          [0,3],[3,0],
          [1,2],[2,1],
          [2,3],[3,2],
          [1,3],[3,1],
        ];

        const state = edgeDirs.map(([from, to]) => ({
          from, to,
          t: Math.random(),
          speed: 0.0022 + Math.random() * 0.0028,
        }));

        const pktEls = Array.from(
          svg.querySelectorAll('.k8s-pkt')
        ) as SVGCircleElement[];

        function frame() {
          state.forEach((p, i) => {
            p.t += p.speed;
            if (p.t > 1) p.t -= 1;
            const a = nodes[p.from];
            const b = nodes[p.to];
            pktEls[i]?.setAttribute('cx', (a.x + (b.x - a.x) * p.t).toFixed(1));
            pktEls[i]?.setAttribute('cy', (a.y + (b.y - a.y) * p.t).toFixed(1));
            pktEls[i]?.setAttribute('opacity', '0.88');
          });
          requestAnimationFrame(frame);
        }

        const section = document.getElementById('cluster-section');
        if (section) {
          new IntersectionObserver((entries, obs) => {
            if (entries[0].isIntersecting) {
              frame();
              obs.disconnect();
            }
          }, { threshold: 0.2 }).observe(section);
        }
      })();
    </script>

    <style>
      @keyframes fadeDown {
        from { opacity: 0; transform: translateY(-16px); }
        to   { opacity: 1; transform: translateY(0); }
      }

      @keyframes bubble-float {
        0%, 100% { transform: translateY(0)    scale(1);    }
        50%       { transform: translateY(-8px) scale(1.04); }
      }

      .nav-link {
        font-size: 0.8125rem;
        font-weight: 500;
        color: rgba(255,255,255,0.55);
        letter-spacing: 0.04em;
        transition: color 0.2s ease;
        text-decoration: none;
        position: relative;
      }
      .nav-link::after {
        content: '';
        position: absolute;
        bottom: -3px;
        left: 0;
        width: 0;
        height: 1.5px;
        background: #818cf8;
        transition: width 0.25s ease;
      }
      .nav-link:hover,
      .nav-link.active {
        color: rgba(255,255,255,0.95);
      }
      .nav-link.active::after,
      .nav-link:hover::after {
        width: 100%;
      }
    </style>

  </body>
</html>
